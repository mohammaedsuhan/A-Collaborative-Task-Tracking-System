# Server
PORT=3000
NODE_ENV=development

# Auth - CHANGE THIS in any real deployment (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Storage
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Optional: AI task description generation (falls back to a template if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
